# ================================================================
# SaludMercal — Frontend (.env.template)
# Copia este archivo como .env.local y completa los valores reales
# ================================================================

# URL base del API de Laravel (backend)
# Ejemplo local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL base del frontend (usada para CORS y callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Entorno de la aplicación (development | production)
NEXT_PUBLIC_APP_ENV=development

# (Opcional) Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=SaludMercal
